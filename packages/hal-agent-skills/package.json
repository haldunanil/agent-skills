{
  "name": "hal-agent-skills-build",
  "version": "1.0.0",
  "description": "Build tooling for Hal Agent Skills",
  "type": "module",
  "scripts": {
    "validate": "npm run validate-rules && npm run validate-skills",
    "validate-rules": "tsx src/validate.ts",
    "validate-skills": "tsx src/validate-skills.ts",
    "build": "npm run build-rules && npm run package-skills",
    "build-rules": "tsx src/build.ts",
    "build-all-rules": "tsx src/build.ts --all",
    "package-skills": "tsx src/package-skills.ts",
    "extract-tests": "tsx src/extract-tests.ts",
    "migrate": "tsx src/migrate.ts",
    "dev": "npm run validate && npm run build"
  },
  "keywords": [
    "hal",
    "agent",
    "skills",
    "llm",
    "agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
